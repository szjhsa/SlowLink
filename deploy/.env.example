# SlowLink 核心业务配置通过网页后台和 Redis 保存。
# 以下配置只控制网页访问方式；安装和管理脚本会自动维护这些值。
# 请勿在公开仓库中提交真实密码、Token、API Hash 或 Session。

SLOWLINK_WEB_MODE=http
SLOWLINK_BIND_HOST=0.0.0.0
SLOWLINK_WEB_PORT=8080
SLOWLINK_DOMAIN=

# 通用可靠性门：可按需要调整，单位均为秒；设为 0 表示关闭对应门。
MESSAGE_MAX_AGE_SECONDS=1800
FORWARD_SOURCE_MAX_AGE_SECONDS=7200
QUEUE_MAX_WAIT_SECONDS=300
